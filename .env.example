# Server & Environment
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Mandatory MongoDB Connection URI (MongoDB Atlas or local mongod)
# Example: mongodb+srv://username:password@cluster.mongodb.net/adam_muhammad_academy?retryWrites=true&w=majority
MONGODB_URI=

# Security & Session Signing Secret (Use a long random string in production)
JWT_SECRET=replace-with-a-long-random-secret-key
JWT_EXPIRES_IN=7d

# Initial Admin Seed Credentials (used by `npm run seed` or initial bootstrap)
ADMIN_SEED_NAME=Academy Administrator
ADMIN_SEED_EMAIL=admin@adammohammadacademy.com
ADMIN_SEED_PASSWORD=ChangeMeNow2026!

# Email / SMTP Configuration (Required for email verification & password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@adammohammadacademy.com

# Optional Cloud Image Storage (Cloudinary)
# If omitted, images are stored securely in /public/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini API key (if using @google/genai server-side)
GEMINI_API_KEY=
